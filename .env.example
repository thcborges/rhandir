# ==============================================================================
# Rhandir - Ingestão Leve para Segundo Cérebro Obsidian (.env.example)
# ==============================================================================

# PostgreSQL Database Configuration (Docker / Local)
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="rhandir"
POSTGRES_PORT=5432
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rhandir"

# Credenciais alternativas / Oracle Cloud (OCI) se aplicável:
# DATABASE_URL="postgresql://<usuario>:<senha>@<host>:5432/<database>"

# Obsidian Vault Configuration (Fronteira Rígida da Pasta Máquina)
# Sincronizado via rclone com Google Drive na pasta data/vault
OBSIDIAN_RAW_DIR="/home/thcborges/prod/rhandir/data/vault/00_Inbox/Raw_Machine"

# Rclone Remote para sincronização do Obsidian Vault
RCLONE_VAULT_REMOTE="gdrive:Obsidian"

# Ingestion Settings
TAKEOUT_INBOX_DIR="/home/thcborges/prod/rhandir/data/takeout"
COOKIES_FILE_PATH="/home/thcborges/prod/rhandir/cookies.txt"

# Daemon & Circuit Breaker Settings
DAEMON_POLL_INTERVAL_SECONDS=60
TRANSCRIPT_RATE_LIMIT_DELAY_MIN=2.0
TRANSCRIPT_RATE_LIMIT_DELAY_MAX=5.0
CIRCUIT_BREAKER_BACKOFF_MINUTES=15
LOG_LEVEL="INFO"
